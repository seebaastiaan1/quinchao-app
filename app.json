{
  "expo": {
    "name": "Quinchao",
    "slug": "quinchao-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "quinchao",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.ulagos.quinchao"
    },
    "android": {
      "package": "cl.ulagos.quinchao"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}

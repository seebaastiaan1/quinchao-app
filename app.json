{
  "expo": {
    "name": "Quinchao",
    "slug": "quinchao-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "quinchao",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.ulagos.quinchao"
    },
    "android": {
      "package": "cl.ulagos.quinchao",
      "config": {
        "googleMaps": {
          "apiKey": "TU_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7257eb0a-838c-42b6-baba-ca82ca56152d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7257eb0a-838c-42b6-baba-ca82ca56152d"
    }
  }
}

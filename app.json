{
  "expo": {
    "name": "Quinchao",
    "slug": "quinchao-app",
    "owner": "purplesebas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "quinchao",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para elegir la imagen de un lugar."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.ulagos.quinchao"
    },
    "android": {
      "package": "cl.ulagos.quinchao",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cc0596aa-c634-4822-85d1-0de84aec528e"
      }
    }
  }
}
